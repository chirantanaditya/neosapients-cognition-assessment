# Optional. Defaults to ./data/assessments.sqlite from the app working directory.
ASSESSMENT_DB_PATH=./data/assessments.sqlite

# Transactional result email. Verify the sender domain in Resend before launch.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NeoSapients Cognition <cognition@neosapients.ai>

# Assessment and callback events. Each webhook operates independently.
ZAPIER_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional. External calls are concurrent and capped at 15 seconds.
INTEGRATION_TIMEOUT_MS=8000

# Required to access the local /admin dashboard and CSV export.
ADMIN_PASSWORD=
