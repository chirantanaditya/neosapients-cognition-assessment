---
import '../styles/admin.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="theme-color" content="#190636" />
    <title>Assessment responses · NeoSapients</title>
  </head>
  <body>
    <main class="admin-shell">
      <header class="admin-header">
        <img class="admin-brand" src="/assets/logo.svg" alt="NeoSapients" />
        <a class="return" href="/index.html">Return to assessment →</a>
      </header>

      <section class="title-row">
        <div>
          <div class="eyebrow">On-device storage</div>
          <h1>Assessment responses</h1>
          <p>Review completed assessments stored on this TV and export the full dataset for backup.</p>
        </div>
        <button class="export" id="export" type="button">Export all as CSV <span>↓</span></button>
      </section>

      <p class="export-status" id="export-status" role="status"></p>

      <section class="stats" aria-label="Assessment summary">
        <article class="stat"><small>Total responses</small><strong id="stat-total">—</strong></article>
        <article class="stat"><small>Scored assessments</small><strong id="stat-scored">—</strong></article>
        <article class="stat"><small>Priority-only</small><strong id="stat-priority">—</strong></article>
        <article class="stat"><small>Follow-up requests</small><strong id="stat-followup">—</strong></article>
        <article class="stat"><small>Average score</small><strong id="stat-average">—</strong></article>
      </section>

      <div class="toolbar">
        <form class="search" id="search-form" role="search">
          <input id="search" type="search" placeholder="Search name, company, email, role or tier" aria-label="Search responses" />
          <button type="submit">Search</button>
        </form>
        <span class="count" id="count">Loading responses…</span>
      </div>

      <div class="table-wrap" id="table-wrap" hidden>
        <table class="responses">
          <thead><tr><th>Participant</th><th>Company</th><th>Submitted</th><th>Path</th><th>Score</th><th>Tier</th><th>Follow-up</th><th>Response</th></tr></thead>
          <tbody id="responses"></tbody>
        </table>
      </div>
      <div class="empty" id="empty">Loading assessment responses…</div>
    </main>
    <script>
      import '../scripts/admin.js';
    </script>
  </body>
</html>
