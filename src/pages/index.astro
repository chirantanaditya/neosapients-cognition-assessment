---
import '../styles/styles.css';
import '../styles/result-screen.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#190636" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" href="/assets/logo.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="Discover your Enterprise AI Cognition Score and how knowledge, memory and governance support accountable AI."
    />
    <title>Enterprise AI Cognition Score · NeoSapients</title>
  </head>
  <body>
    <div id="app"></div>
    <div id="announcer" class="sr-only" role="status" aria-live="polite"></div>
    <div id="troubleshoot-modal" class="troubleshoot-modal" role="dialog" aria-modal="true" aria-labelledby="troubleshoot-title" hidden>
      <form id="troubleshoot-form" class="troubleshoot-card" autocomplete="off">
        <div class="troubleshoot-heading">
          <div>
            <span>Protected export</span>
            <h2 id="troubleshoot-title">Troubleshoot</h2>
          </div>
          <button id="troubleshoot-close" class="troubleshoot-close" type="button" aria-label="Close troubleshooting">×</button>
        </div>
        <p>Enter the troubleshooting password to export every saved submission as a CSV file.</p>
        <label for="troubleshoot-password">Password</label>
        <input id="troubleshoot-password" name="password" type="password" autocomplete="off" required aria-describedby="troubleshoot-status" />
        <p id="troubleshoot-status" class="troubleshoot-status" role="status" aria-live="polite"></p>
        <button id="troubleshoot-export" class="primary" type="submit">Export all submissions <span aria-hidden="true">↓</span></button>
      </form>
    </div>
    <div id="attract-mode" class="attract-mode" hidden aria-label="NeoSapients showcase video">
      <video
        id="attract-video"
        muted
        loop
        playsinline
        preload="auto"
        disablepictureinpicture
        disableRemotePlayback
        aria-label="NeoSapients showcase video"
      >
        <source src="/assets/attract-mode.mp4" type="video/mp4" />
      </video>
      <button id="attract-start" class="attract-mode-cta" type="button">
        Assess your AI readiness score
      </button>
    </div>
    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
